<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>OpenRung.WinUI</RootNamespace>
		<AssemblyName>OpenRung.WinUI</AssemblyName>
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- Unpackaged, single-exe style deployment: no MSIX identity. -->
		<WindowsPackageType>None</WindowsPackageType>
		<!-- Carry the Windows App SDK beside the exe so no runtime install is needed. -->
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<Platforms>x64</Platforms>
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
		<SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
		<UseWinUI>true</UseWinUI>
		<EnablePreviewMsixTooling>true</EnablePreviewMsixTooling>
		<Nullable>enable</Nullable>
		<!-- Win32TrayIcon uses raw pointers/struct pinning for Shell_NotifyIcon. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
	</ItemGroup>
</Project>
