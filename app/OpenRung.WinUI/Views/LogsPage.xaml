<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenRung.WinUI.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Click="Clear_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                    <TextBlock Text="清空" />
                </StackPanel>
            </Button>
            <Button Click="Copy_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                    <TextBlock Text="复制" />
                </StackPanel>
            </Button>
            <ToggleButton
                VerticalAlignment="Center"
                IsChecked="{x:Bind ViewModel.AutoScroll, Mode=TwoWay}"
                Content="自动滚动" />
        </StackPanel>

        <ListView
            Grid.Row="1"
            x:Name="LogList"
            Margin="0,8,0,0"
            FontFamily="Consolas, 'Courier New'"
            ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        FontFamily="Consolas, 'Courier New'"
                        FontSize="12"
                        Text="{Binding}"
                        TextWrapping="Wrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
