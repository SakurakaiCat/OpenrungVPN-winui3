<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenRung.WinUI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Big connect area -->
        <Border
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="32"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.RelayLabel, Mode=OneWay, FallbackValue='未连接'}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}">
                        <Run Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{x:Bind ViewModel.Mode, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <Button
                    x:Name="ConnectButton"
                    Width="200"
                    Height="40"
                    HorizontalAlignment="Center"
                    Click="ConnectButton_Click"
                    Content="{x:Bind ViewModel.ConnectButtonText, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.NotBusy, Mode=OneWay}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- Last error banner -->
        <InfoBar
            Grid.Row="2"
            x:Name="ErrorBar"
            Severity="Error"
            Title="错误"
            IsOpen="False"
            Message="{x:Bind ViewModel.LastError, Mode=OneWay}" />
    </Grid>
</Page>
