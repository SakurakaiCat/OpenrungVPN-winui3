  <PropertyGroup Label="Globals">
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <MinimalCoreWin>true</MinimalCoreWin>
    <ProjectGuid>{5C3E2A1D-7B4F-4C9E-8D2A-1F6B3C4D5E6F}</ProjectGuid>
    <ProjectName>OpenRung.WinUI</ProjectName>
    <RootNamespace>OpenRung.WinUI</RootNamespace>
    <!-- $(TargetName) must match $(RootNamespace): the generated .winmd carries
         the root namespace name and XAML looks it up next to the exe. -->
    <TargetName>$(RootNamespace)</TargetName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>16.0</MinimumVisualStudioVersion>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <!-- Desktop WinUI3 (unpackaged): need WinRT projections but NOT the
         UWP app-container API family which hides CreateFileW/menus/etc. -->
    <AppContainerApplication>true</AppContainerApplication>
    <_NoWinAPIFamilyApp>true</_NoWinAPIFamilyApp>
    <!-- 10.0 = auto-pick latest installed SDK (CI runners may lack 26100). -->
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackage>false</AppxPackage>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- NuGet hard-codes framework 'native' for every .vcxproj during restore,
         but the build-time asset check demands UAP for Windows Store app types,
         so the two can never agree on the command line. C++ projects consume
         packages through their build/.props+.targets (CppWinRT, WindowsAppSDK),
         not through managed asset resolution - disable the check entirely.
         TargetFrameworkMoniker stays UAP for the XAML compiler's
         ReferenceGrouping; TargetFrameworks feeds restore's per-framework alias. -->
    <ResolveNuGetPackages>false</ResolveNuGetPackages>
    <TargetFrameworkMoniker>UAP,Version=v10.0</TargetFrameworkMoniker>
    <TargetFrameworks>UAP,Version=v10.0</TargetFrameworks>
    <!-- Matches the generated .nuget.g.props ImportGroup/Pkg* condition. -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">UAP,Version=v10.0</TargetFramework>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '17.0'">v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <DesktopCompatible>true</DesktopCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
    <LinkIncremental>true</LinkIncremental>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
