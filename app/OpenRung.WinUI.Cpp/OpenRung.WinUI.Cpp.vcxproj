  <!-- Ship the flag icons / logos next to the exe; ms-appx:/// URIs resolve
       against the exe directory for unpackaged apps. -->
  <ItemGroup>
    <None Include="Assets\**\*" />
  </ItemGroup>
  <Target Name="CopyAssets" AfterTargets="Build">
    <ItemGroup>
      <_AssetFiles Include="$(ProjectDir)Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AssetFiles)"
          DestinationFiles="@(_AssetFiles->'$(TargetDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <!-- The XAML compiler writes code-behind glue into a subfolder mirroring
       the .xaml file location (Generated Files\Views\*.xaml.g.h), while
       C++/WinRT's per-type projection headers expect it next to them under
       the namespace-dotted name (Generated Files\*.xaml.g.h). XAML classes
       live in the root namespace, so flatten the copies after each pass. -->
  <!-- The XamlCompiler-derived AppT bases on the generic projection
       ApplicationT<D, IXamlMetadataProvider>, which makes com_ref of
       implementation::App resolve to Application and breaks cppwinrt's own
       generated App::App() ctor in App.g.cpp (C2665). Pages are fine because
       they derive from <Class>_base. Rebase AppT onto App_base (from the
       cppwinrt-generated App.g.h), which implements the projected App class
       and restores the move-ctor overload. Idempotent: no-op once patched. -->
  <Target Name="PatchAppGlueBase" AfterTargets="MarkupCompilePass1"
          Condition="Exists('$(XamlGeneratedOutputPath)App.xaml.g.h')">
<Exec Command="powershell.exe -NoProfile -Command &quot;$f='$(XamlGeneratedOutputPath)App.xaml.g.h'; $t=[IO.File]::ReadAllText($f); $u=$t.Replace('struct AppT: public ::winrt::Microsoft::UI::Xaml::ApplicationT&lt;D, ::winrt::Microsoft::UI::Xaml::Markup::IXamlMetadataProvider','struct AppT: public App_base&lt;D, ::winrt::Microsoft::UI::Xaml::Markup::IXamlMetadataProvider'); if($u -ne $t){[IO.File]::WriteAllText($f,$u)}&quot;" />
  </Target>
  <Target Name="FlattenXamlGlueHeaders" AfterTargets="MarkupCompilePass1">
    <ItemGroup>
      <_XamlGlueH Include="$(XamlGeneratedOutputPath)Views\*.xaml.g.h" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlGlueH)"
          DestinationFiles="@(_XamlGlueH->'$(XamlGeneratedOutputPath)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="FlattenXamlGlueSources" AfterTargets="MarkupCompilePass2">
    <ItemGroup>
      <_XamlGlueCpp Include="$(XamlGeneratedOutputPath)Views\*.xaml.g.cpp" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlGlueCpp)"
          DestinationFiles="@(_XamlGlueCpp->'$(XamlGeneratedOutputPath)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

