<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenRung.WinUI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
        <StackPanel Padding="24" Spacing="16" MaxWidth="560">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="设置" />

        <StackPanel Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="捕获模式" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap">
                代理模式仅接管系统代理；TUN 模式接管全设备流量，需要管理员权限。
            </TextBlock>
            <ComboBox
                x:Name="ModeCombo"
                HorizontalAlignment="Left"
                SelectionChanged="ModeCombo_SelectionChanged">
                <ComboBoxItem Content="代理模式" Tag="proxy" />
                <ComboBoxItem Content="TUN 模式" Tag="tun" />
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="系统代理" />
            <TextBlock
                x:Name="SystemProxyText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
            <CheckBox
                x:Name="AutoClearCheck"
                Checked="AutoClearProxy_Checked"
                Unchecked="AutoClearProxy_Unchecked"
                Content="启动时自动清除已有系统代理" />
            <Button
                x:Name="ClearProxyButton"
                HorizontalAlignment="Left"
                Click="ClearProxy_Click"
                Content="立即清除系统代理" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="核心" />
            <TextBlock x:Name="CoreVersionText" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="EngineText" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="EndpointText" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="关于" />
            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <Image Width="128" Height="128" HorizontalAlignment="Center">
                    <Image.Source>
                        <SvgImageSource
                            RasterizePixelHeight="256"
                            RasterizePixelWidth="256"
                            UriSource="ms-appx:///Assets/openrung-mark.svg" />
                    </Image.Source>
                </Image>
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Text="OpenRung VPN" />
                <Image
                    Width="88"
                    Height="88"
                    HorizontalAlignment="Center">
                    <Image.Source>
                        <BitmapImage UriSource="ms-appx:///Assets/avatar.jpg" />
                    </Image.Source>
                </Image>
                <HyperlinkButton
                    HorizontalAlignment="Center"
                    Content="GitHub @SakurakaiCat"
                    NavigateUri="https://github.com/SakurakaiCat" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="OpenRung VPN WinUI3 客户端 · 维护者 @SakurakaiCat" />
            </StackPanel>
            <TextBlock x:Name="AppVersionText" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap">
                <Run Text="OpenRung VPN WinUI3 由 " />
                <Run FontWeight="SemiBold" Text="@SakurakaiCat" />
                <Run Text=" 基于 OpenRung 仓库二次开发。" />
            </TextBlock>
            <HyperlinkButton
                Content="OpenRung 上游仓库 · github.com/openrung/openrung"
                NavigateUri="https://github.com/openrung/openrung" />
            <HyperlinkButton
                Content="本客户端仓库 · github.com/SakurakaiCat/OpenrungVPN-winui3"
                NavigateUri="https://github.com/SakurakaiCat/OpenrungVPN-winui3" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="CheckUpdateButton"
                    Click="CheckUpdate_Click"
                    Content="检查更新" />
                <TextBlock
                    x:Name="UpdateStatusText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Text="Copyright © 2026 @SakurakaiCat。本客户端基于上游 OpenRung 的修改作品，与上游 OpenRung 均以 GNU General Public License v3.0（GPL-3.0）发布，详见仓库根目录的 LICENSE 文件。" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Page>
