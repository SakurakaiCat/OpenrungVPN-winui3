<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenRung.WinUI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
        <StackPanel Padding="24" Spacing="16" MaxWidth="560">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Text="设置" />

        <StackPanel Spacing="4">
            <TextBlock x:Name="CaptureModeHeader" FontWeight="SemiBold" Text="捕获模式" />
            <TextBlock
                x:Name="CaptureModeDesc"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap">
                代理模式仅接管系统代理；TUN 模式接管全设备流量，需要管理员权限。
            </TextBlock>
            <ComboBox
                x:Name="ModeCombo"
                HorizontalAlignment="Left"
                SelectionChanged="ModeCombo_SelectionChanged">
                <ComboBoxItem Content="代理模式" Tag="proxy" />
                <ComboBoxItem Content="TUN 模式" Tag="tun" />
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Name="SystemProxyHeader" FontWeight="SemiBold" Text="系统代理" />
            <TextBlock
                x:Name="SystemProxyText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
            <CheckBox
                x:Name="AutoClearCheck"
                Checked="AutoClearProxy_Checked"
                Unchecked="AutoClearProxy_Unchecked"
                Content="启动时自动清除已有系统代理" />
            <Button
                x:Name="ClearProxyButton"
                HorizontalAlignment="Left"
                Click="ClearProxy_Click"
                Content="立即清除系统代理" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Name="LanguageHeader" FontWeight="SemiBold" Text="语言" />
            <ComboBox
                x:Name="LanguageCombo"
                HorizontalAlignment="Left"
                SelectionChanged="LanguageCombo_SelectionChanged">
                <ComboBoxItem Content="跟随系统" Tag="system" />
                <ComboBoxItem Content="简体中文" Tag="zh" />
                <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Name="RelayHeader" FontWeight="SemiBold" Text="节点列表" />
            <ToggleSwitch
                x:Name="HideCnToggle"
                HorizontalAlignment="Left"
                Margin="0,4,0,0"
                Toggled="HideCnToggle_Toggled" />
            <TextBlock
                x:Name="HideCnDesc"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Name="DnsHeader" FontWeight="SemiBold" Text="DNS" />
            <TextBlock
                x:Name="DnsDesc"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap">
                隧道内域名解析使用的 DNS 服务器；修改在下次连接时生效。
            </TextBlock>
            <ComboBox
                x:Name="DnsCombo"
                HorizontalAlignment="Left"
                SelectionChanged="DnsCombo_SelectionChanged">
                <ComboBoxItem Content="自动（1.1.1.1 / 8.8.8.8）" Tag="auto" />
                <ComboBoxItem Content="Cloudflare" Tag="cloudflare" />
                <ComboBoxItem Content="Google" Tag="google" />
                <ComboBoxItem Content="AliDNS" Tag="alidns" />
                <ComboBoxItem Content="Quad9" Tag="quad9" />
                <ComboBoxItem Content="自定义" Tag="custom" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="Collapsed" x:Name="DnsCustomPanel">
                <TextBox
                    x:Name="DnsCustomBox"
                    MinWidth="280"
                    PlaceholderText="1.1.1.1, 8.8.8.8, 2606:4700:4700::1111" />
                <Button
                    x:Name="DnsSaveButton"
                    Click="DnsSave_Click"
                    Content="保存" />
            </StackPanel>
            <ToggleSwitch
                x:Name="Ipv6Toggle"
                HorizontalAlignment="Left"
                Margin="0,4,0,0"
                Toggled="Ipv6Toggle_Toggled" />
            <TextBlock
                x:Name="DnsIpv6Desc"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
            <TextBlock x:Name="DnsStatusText" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Name="CoreHeader" FontWeight="SemiBold" Text="核心" />
            <TextBlock x:Name="CoreVersionText" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="EngineText" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="EndpointText" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="CoreStatusText" Style="{StaticResource CaptionTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="CoreStartButton"
                    Click="CoreStart_Click"
                    Content="启动核心" />
                <Button
                    x:Name="CoreStopButton"
                    Click="CoreStop_Click"
                    Content="停止核心" />
                <Button
                    x:Name="CoreRestartButton"
                    Click="CoreRestart_Click"
                    Content="重启核心" />
            </StackPanel>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                x:Name="CoreManagerHint"
                TextWrapping="Wrap"
                Text="重启核心会保留当前提权状态（TUN 模式下将重新弹出 UAC 确认）。" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Name="AboutHeader" FontWeight="SemiBold" Text="关于" />
            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <Image Width="128" Height="128" HorizontalAlignment="Center">
                    <Image.Source>
                        <SvgImageSource
                            RasterizePixelHeight="256"
                            RasterizePixelWidth="256"
                            UriSource="ms-appx:///Assets/openrung-mark.svg" />
                    </Image.Source>
                </Image>
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Text="OpenRung VPN" />
                <Image
                    Width="88"
                    Height="88"
                    HorizontalAlignment="Center">
                    <Image.Source>
                        <BitmapImage UriSource="ms-appx:///Assets/avatar.jpg" />
                    </Image.Source>
                </Image>
                <HyperlinkButton
                    HorizontalAlignment="Center"
                    Content="GitHub @SakurakaiCat"
                    NavigateUri="https://github.com/SakurakaiCat" />
                <TextBlock
                    x:Name="AboutMaintainerText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="OpenRung VPN WinUI3 客户端 · 维护者 @SakurakaiCat" />
            </StackPanel>
            <TextBlock x:Name="AppVersionText" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock
                x:Name="AboutDevText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Text="OpenRung VPN WinUI3 由 @SakurakaiCat 基于 OpenRung 仓库二次开发。" />
            <HyperlinkButton
                Content="OpenRung 上游仓库 · github.com/openrung/openrung"
                NavigateUri="https://github.com/openrung/openrung" />
            <HyperlinkButton
                Content="本客户端仓库 · github.com/SakurakaiCat/OpenrungVPN-winui3"
                NavigateUri="https://github.com/SakurakaiCat/OpenrungVPN-winui3" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="CheckUpdateButton"
                    Click="CheckUpdate_Click"
                    Content="检查更新" />
                <TextBlock
                    x:Name="UpdateStatusText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <TextBlock
                x:Name="CopyrightText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Text="Copyright © 2026 @SakurakaiCat。本客户端基于上游 OpenRung 的修改作品，与上游 OpenRung 均以 GNU General Public License v3.0（GPL-3.0）发布，详见仓库根目录的 LICENSE 文件。" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Page>
