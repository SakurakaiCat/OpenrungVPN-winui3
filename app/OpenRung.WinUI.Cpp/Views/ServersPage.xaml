<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenRung.WinUI.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:m="using:OpenRung.WinUI"
    mc:Ignorable="d">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UpdateRemoteButton" Grid.Column="0" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    <TextBlock Text="从远端更新节点" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock
                    x:Name="SummaryText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    x:Name="TestStatusText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </StackPanel>
            <Button x:Name="AutoSelectToolbarButton" Grid.Column="2" Click="AutoSelect_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE945;" FontSize="12" />
                    <TextBlock Text="自动选择最低延迟" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="TcpingButton" Click="Tcping_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE9D2;" FontSize="12" />
                    <TextBlock Text="TCPing 测试" />
                </StackPanel>
            </Button>
            <Button x:Name="RealDelayButton" Click="RealDelay_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE9F5;" FontSize="12" />
                    <TextBlock Text="真延迟测试" />
                </StackPanel>
            </Button>
            <TextBlock
                x:Name="TestHint"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="TCPing：并发握手测速；真延迟：逐个节点经隧道实测（需断开连接）" />
        </StackPanel>

        <ProgressBar
            Grid.Row="2"
            x:Name="LoadingBar"
            Margin="0,8,0,0"
            IsIndeterminate="False"
            Visibility="Collapsed" />

        <!-- Inline error surface: keeps refresh failures visible even before
             the page has a XamlRoot (a ContentDialog would crash there). -->
        <InfoBar
            Grid.Row="3"
            x:Name="ErrorBar"
            Margin="0,8,0,0"
            IsOpen="False"
            Severity="Error"
            Title="刷新失败" />

        <ListView
            Grid.Row="4"
            x:Name="RelayList"
            Margin="0,8,0,0"
            SelectionMode="Single"
            SelectionChanged="RelayList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:RelayRow">
                    <Grid ColumnSpacing="8" Padding="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="0"
                            Width="24"
                            Height="18"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Source="{x:Bind FlagImage, Mode=OneTime}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayTitle, Mode=OneTime}" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Label, Mode=OneTime}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind NodeClass, Mode=OneTime}" />
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind LatencyText, Mode=OneTime}" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Text="{x:Bind TestText, Mode=OneTime}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
